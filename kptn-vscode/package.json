{
  "name": "kptn",
  "displayName": "kptn",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/rjruizes/kptn.git",
    "directory": "kptn-vscode"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:kptn.openUI"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kptn.openUI",
        "title": "kptn: Open Pipeline UI"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "mocha --ui tdd \"out/test/**/*.test.js\"",
    "test:vscode": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "@types/vscode": "^1.100.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^9.39.1",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
